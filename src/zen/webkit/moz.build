XPIDL_SOURCES += [
    "nsIZenWebKitView.idl",
]

EXPORTS.mozilla += [
    "nsZenWebKitView.h",
]

SOURCES += [
    "nsZenWebKitView.mm",
    "ZenWebKitBridge.mm",
]

LOCAL_INCLUDES += [
    "/zen/webkit",
]

OS_LIBS += ["-framework WebKit"]

